# M6 controlled namespace cases executed by the native WSH runtime.
switch ($1) {
case TC-0024;
    test::begin TC-0024 'standard-library cleanup';
    fs::temp-dir --into root m6-cleanup-;
    path::join --into file $root data.txt;
    fs::write $file payload;
    fs::remove --recursive $root;
    fs::exists $root;
    test::assert-status 1;
    test::end
case TC-0037;
    test::begin TC-0037 'standard-library Unicode';
    fs::temp-file --into file m6-unicode-;
    text::encode --from utf-8 --to utf-16le --output $file 'snowman-☃';
    fs::read --encoding utf-16le --into actual $file;
    test::assert-equal 'snowman-☃' $actual;
    fs::remove $file;
    test::end
case TC-0065;
    test::begin TC-0065 'embedded namespace conformance';
    library::list --into names;
    test::assert-equal 56 $#names;
    for (name in $names) {
        library::describe $name;
        test::assert;
        whatis $name;
        test::assert;
    };
    text::join --separator : --into joined alpha beta;
    test::assert-equal alpha:beta $joined;
    text::split --separator : --keep-empty --into split 'alpha::beta';
    expected_split=(alpha '' beta);
    test::assert-list expected_split split;
    text::replace --old old --new new --into replaced old-old;
    test::assert-equal new-new $replaced;
    text::format --into formatted '{0}/{1}' alpha beta;
    test::assert-equal alpha/beta $formatted;
    text::compare --ordinal-ignore-case Alpha alpha;
    test::assert;
    fs::temp-dir --into root m6-conformance-;
    path::join --into file $root item.txt;
    path::directory --into directory $file;
    test::assert-equal $root $directory;
    path::name --into name $file;
    test::assert-equal item.txt $name;
    path::extension --into extension $file;
    test::assert-equal .txt $extension;
    path::change-extension --into changed $file bin;
    path::extension --into changed_extension $changed;
    test::assert-equal .bin $changed_extension;
    path::normalize --into normalized 'alpha/./beta/../gamma';
    test::assert-equal 'alpha\gamma' $normalized;
    path::absolute --into absolute $root;
    test::assert-equal $root $absolute;
    path::relative --into relative $root $file;
    test::assert-equal item.txt $relative;
    path::is-within $root $file;
    test::assert;
    path::is-root $root;
    test::assert-status 1;
    fs::write $file payload;
    fs::exists $file;
    test::assert;
    fs::type --into type $file;
    test::assert-equal file $type;
    fs::stat --into metadata $file;
    test::assert-equal 6 $#metadata;
    path::join --into copy $root copy.txt;
    path::join --into moved $root moved.txt;
    fs::copy $file $copy;
    fs::compare $file $copy;
    test::assert;
    fs::move $copy $moved;
    fs::compare $file $moved;
    test::assert;
    fs::read --into content $moved;
    test::assert-equal payload $content;
    system::architecture --into architectures;
    test::assert-equal 2 $#architectures;
    system::windows-version --into windows_version;
    test::assert-equal 5 $#windows_version;
    system::wsh-version --into wsh_version;
    test::assert-equal 4 $#wsh_version;
    system::environment --into environment_names;
    test::assert;
    time::now --utc --into instant;
    test::assert;
    time::monotonic --into monotonic;
    test::assert;
    time::sleep 1;
    fs::remove --recursive $root;
    test::end
case TC-0066;
    test::begin TC-0066 'filesystem mutation safety';
    fs::remove --recursive .;
    test::assert-status 1;
    fs::temp-dir --into root m6-safety-;
    path::join --into nested $root nested;
    path::join --into sentinel $nested sentinel.txt;
    fs::mkdir --parents $nested;
    fs::write $sentinel retained;
    fs::remove --recursive $root;
    fs::exists $root;
    test::assert-status 1;
    test::end
case TC-0067;
    test::begin TC-0067 'process-library orchestration';
    process::which --into resolved $2;
    test::assert-equal $2 $resolved;
    raw_line='"'^$2^'" raw marker';
    process::raw -- $2 $raw_line;
    test::assert;
    process::capture --stdout captured --set 'M6_PROBE=visible' -- $2 env M6_PROBE;
    test::assert-equal visible $captured;
    process::capture --stdout out --stderr err -- $2 stderr problem;
    test::assert-equal '' $out;
    test::assert-equal problem $err;
    fs::temp-file --into encoded m6-process-encoding-;
    text::encode --from utf-8 --to utf-16le --output $encoded 'wide-☃';
    process::capture --stdout decoded --encoding utf-16le --stdin $encoded -- $2 copy;
    test::assert-equal 'wide-☃' $decoded;
    fs::remove $encoded;
    process::parallel --jobs 2 -- 'time::sleep 20' 'time::sleep 1';
    test::assert-status 0 0;
    process::run --timeout 10 -- $2 sleep 80;
    test::assert-status 9;
    process::wait;
    test::assert-status 0;
    process::cancel;
    test::assert-status 130;
    test::end
case TC-0068;
    test::begin TC-0068 'test namespace and evidence';
    expected=(one 'two words');
    actual=(one 'two words');
    test::assert-list expected actual;
    text::compare different values;
    test::assert-status 1;
    fs::temp-dir --into root m6-evidence-;
    path::join --into first $root first.txt;
    path::join --into second $root second.txt;
    fs::write $first evidence;
    fs::copy $first $second;
    test::assert-file $first $second;
    fs::remove --recursive $root;
    test::end
case TC-0070;
    test::begin TC-0070 'library isolation';
    private_value=retained;
    process::capture --stdout child --set 'M6_CHILD=isolated' -- $2 env M6_CHILD;
    test::assert-equal isolated $child;
    test::assert-equal retained $private_value;
    system::environment --into environment_names;
    test::assert;
    test::end
case TC-0074;
    test::begin TC-0074 'library resource limits';
    fs::temp-file --into file m6-limit-;
    fs::write $file bounded;
    fs::hash --sha256 --into digest $file;
    test::assert-equal 73060ad79f2c28d9235e910e8040ca93e7e6a611a3df4f0aa3d0cf3616b37ba5 $digest;
    process::run --timeout 5 -- $2 sleep 40;
    test::assert-status 9;
    fs::remove $file;
    test::end
case TC-0075;
    test::begin TC-0075 'library deterministic traversal';
    fs::temp-dir --into root m6-dfs-;
    path::join --into a $root a.txt;
    path::join --into sub $root sub;
    path::join --into middle $sub middle.txt;
    path::join --into z $root z.txt;
    fs::mkdir $sub;
    fs::write $z z;
    fs::write $middle m;
    fs::write $a a;
    fs::list --recursive --into actual $root;
    expected=($a $sub $middle $z);
    test::assert-list expected actual;
    fs::remove --recursive $root;
    test::end
}
