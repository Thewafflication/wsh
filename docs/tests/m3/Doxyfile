PROJECT_NAME           = "WSH M3 Lexer Parser AST"
PROJECT_NUMBER         = "M3"
OUTPUT_DIRECTORY       = ../../../out/doxygen/m3
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
INPUT                  = ../../../include/wsh/parser.h \
                         ../../../src/parser.c \
                         ../../../tests/parser_tests.c
FILE_PATTERNS          = *.c *.h
RECURSIVE              = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
